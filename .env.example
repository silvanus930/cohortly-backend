# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=Cohortly
APP_URL=http://localhost:3000
# Comma separated list of origins allowed by CORS. Use * to allow any origin.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cohortly
DATABASE_SSL=false
DATABASE_LOGGING=false

# ---------------------------------------------------------------------------
# Rate limiting (requests per window, per client IP)
# ---------------------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=12
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# OAuth client id from Google Cloud Console. Leave empty to disable Google login.
GOOGLE_CLIENT_ID=
# Seeded on boot when both values are present.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=ChangeMe123
SUPERADMIN_FIRST_NAME=Platform
SUPERADMIN_LAST_NAME=Owner

# ---------------------------------------------------------------------------
# Email (smtp | log | memory)
# ---------------------------------------------------------------------------
MAIL_TRANSPORT=log
MAIL_FROM=Cohortly <no-reply@cohortly.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
